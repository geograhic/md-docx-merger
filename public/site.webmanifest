{
  "name": "Markdown 批量转 Word / 合并",
  "short_name": "MD→Word",
  "description": "纯前端、本地运行的 Markdown 批量转 Word 与合并工具，支持 Word 合并、Markdown 合并、图片内嵌，数据不出本机。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6fb",
  "theme_color": "#2563eb",
